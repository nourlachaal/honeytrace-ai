# Collector account: write access (INSERT).
DATABASE_URL=postgresql://hive:REPLACE_WITH_PASSWORD@127.0.0.1:5433/honeytrace

# Read-only account for the API. Never the collector's write account.
API_DATABASE_URL=postgresql://honeytrace_api:REPLACE_WITH_PASSWORD@127.0.0.1:5433/honeytrace

# Used by docker-compose.yml to initialize the container on FIRST start only.
# These must match the passwords in the two URLs above.
POSTGRES_PASSWORD=REPLACE_WITH_PASSWORD
API_DATABASE_PASSWORD=REPLACE_WITH_PASSWORD
